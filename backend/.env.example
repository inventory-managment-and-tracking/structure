PORT=3001
NODE_ENV=development
# Local dev (matches db.js fallback): postgres / clothtrack / password below
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clothtrack
DB_USER=postgres
DB_PASSWORD=1234
# Production server example:
# DB_NAME=clothtrack_production
# DB_USER=delivery_user
# DB_PASSWORD=your_db_password_here
DB_SSL=false
JWT_SECRET=super_clothtrack_secret_jwt_key_prod_2026
JWT_EXPIRES_IN=24h
DEPLOY_WEBHOOK_SECRET=your_deploy_webhook_secret_here
